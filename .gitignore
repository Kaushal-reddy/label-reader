# Virtual environment (recreate with: python -m venv .venv + pip install -r requirements.txt)
.venv/
# Generated images and results; can always be regenerated by re-running the scripts
output/
__pycache__/
# Test data: the photos and true serials are real serial numbers of personal
# devices, so they stay out of the public repo (described in README instead).
# The empty photos/ folder is kept so the scripts find it.
photos/*
!photos/.gitkeep
truth.csv
.DS_Store

.serana/